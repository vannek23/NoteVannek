<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/neumorphic_card"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvRowNumber"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1." />

    <EditText
        android:id="@+id/etRowText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:minHeight="40dp"
        android:paddingVertical="0dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:hint="@string/hint_text"
        android:textColorHint="@color/text_secondary"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="actionNext"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/endContainer"
        app:layout_constraintStart_toEndOf="@id/tvRowNumber"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

    <FrameLayout
        android:id="@+id/endContainer"
        android:layout_width="90dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/etRowSum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="0dp"
            android:background="@android:color/transparent"
            android:gravity="end|center_vertical"
            android:hint="@string/hint_zero"
            android:textColorHint="@color/text_secondary"
            android:inputType="number"
            android:maxLength="4"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:fontFamily="sans-serif-medium"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            tools:ignore="TouchTargetSizeCheck,TextContrastCheck" />

        <TextView
            android:id="@+id/tvRowEmoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="false"
            android:gravity="end|center_vertical"
            android:paddingVertical="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="26sp"
            android:visibility="gone"
            android:text="@string/emoji_check" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>