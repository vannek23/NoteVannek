<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Темная тень (снизу-справа) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/shadow_dark" />
            <padding android:bottom="4dp" android:right="4dp" />
        </shape>
    </item>
    <!-- Светлый блик (сверху-слева) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/shadow_light" />
            <padding android:top="4dp" android:left="4dp" />
        </shape>
    </item>
    <!-- Сама карточка -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/bg_soft" />
        </shape>
    </item>
</layer-list>